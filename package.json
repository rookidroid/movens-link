{
  "name": "movens-link",
  "productName": "Movens Link",
  "version": "0.1.0",
  "description": "Desktop controller for the Movens robot arm over WiFi",
  "author": "rookidroid",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "mock": "tsx scripts/mock-robot.ts",
    "web": "vite --config vite.web.config.ts",
    "diagrams": "electron scripts/joint-diagrams/render.mjs",
    "icons": "electron scripts/icons.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  }
}
